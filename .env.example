# Copy this file to .env and fill in your values.
# Leave the Supabase lines empty to keep storing events in local files.

PORT=4000

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key (secret). Server only — never put it in frontend code or commit it.
SUPABASE_SERVICE_ROLE_KEY=
